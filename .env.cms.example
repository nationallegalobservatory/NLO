# --- Required for the NLO Editorial CMS ---
# Copy this file to .env.local and fill in real values.

# Session signing secret (HMAC-SHA256). Generate with:
#   openssl rand -hex 32
CMS_SESSION_SECRET=replace_me_with_a_long_random_string_min_32_chars

# Supabase. The CMS uses the service role key to bypass RLS for backend
# operations (user mgmt, file storage, send log). Never expose this to the
# browser — Next.js will only inline NEXT_PUBLIC_* vars.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey..._service_role

# --- LLM provider (at least one) ---
# NVIDIA NIM is the default primary. Free tier: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# OmniRoute (local LLM router — see ~/omniroute). Auto-uses free providers
# across 237+ models. Set when the daemon is running.
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_DEFAULT_MODEL=if/kimi-k2-thinking

# Google Gemini (fallback)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# --- Email (Resend) ---
# Required for sending newsletters and magic-link login emails.
# Get a key: https://resend.com
RESEND_API_KEY=re_...

# From address used for newsletter campaigns (must be on a verified domain in Resend).
NEWSLETTER_FROM=National Legal Observatory <hello@thenlo.org>

# From address used for magic-link sign-in emails.
CMS_MAGIC_LINK_FROM=NLO CMS <cms@thenlo.org>
